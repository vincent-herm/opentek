---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Formation IA, certification et prestations numériques — par Vincent Hermitant, Ardèche',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Opentek</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://opentek.fr/#vincent",
          "name": "Vincent Hermitant",
          "url": "https://opentek.fr",
          "telephone": "+33646246199",
          "jobTitle": "Formateur IA",
          "description": "Formateur en intelligence artificielle pour TPE, indépendants et PME, basé en Sud-Ardèche.",
          "areaServed": {
            "@type": "GeoCircle",
            "geoMidpoint": {
              "@type": "GeoCoordinates",
              "addressLocality": "Payzac",
              "addressRegion": "Ardèche",
              "addressCountry": "FR"
            },
            "description": "Sud-Ardèche et départements limitrophes"
          }
        },
        {
          "@type": "LocalBusiness",
          "@id": "https://opentek.fr/#opentek",
          "name": "Opentek",
          "url": "https://opentek.fr",
          "telephone": "+33646246199",
          "description": "Formation IA, certification RS7344 et prestations numériques — par Vincent Hermitant, formateur en Ardèche.",
          "founder": { "@id": "https://opentek.fr/#vincent" },
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Payzac",
            "addressRegion": "Ardèche",
            "postalCode": "07230",
            "addressCountry": "FR"
          },
          "areaServed": [
            "Ardèche",
            "Gard",
            "Lozère",
            "Drôme",
            "Aveyron"
          ]
        }
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>