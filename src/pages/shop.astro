---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Shop — Formations & Services IA">
  <style>
    :global(body) {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
    }

    .hero-gradient {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .card-shine {
      position: relative;
      overflow: hidden;
    }

    .card-shine::after {
      content: '';
      position: absolute;
      top: -50%;
      right: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%);
      animation: shine 3s infinite;
    }

    @keyframes shine {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .badge-new {
      position: absolute;
      top: -10px;
      right: -10px;
      background: #ff6b6b;
      color: white;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      transform: rotate(45deg);
      transform-origin: center;
    }

    .price-highlight {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  </style>

  <!-- Hero Section -->
  <section class="hero-gradient text-white py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-5xl font-bold mb-6">Maîtrisez l'IA dès aujourd'hui</h1>
      <p class="text-xl opacity-90 mb-8">
        Des guides complets, formations live, et consultations personnalisées pour transformer votre approche de l'IA.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <span class="inline-block bg-white/20 px-4 py-2 rounded-full text-sm">✨ Accès instant</span>
        <span class="inline-block bg-white/20 px-4 py-2 rounded-full text-sm">🎯 Par experts</span>
        <span class="inline-block bg-white/20 px-4 py-2 rounded-full text-sm">💡 Pratique</span>
      </div>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="py-16 px-4 bg-gray-50">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-2 text-gray-900">Nos Offres</h2>
      <p class="text-center text-gray-600 mb-12">Choisissez ce qui correspond à vos besoins</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Product 1: Guide -->
        <div class="card-shine bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="bg-gradient-to-br from-blue-500 to-blue-600 p-8 text-white">
            <h3 class="text-2xl font-bold mb-2">Maîtriser Claude</h3>
            <p class="opacity-90 text-sm">Guide complet pour experts</p>
          </div>

          <div class="p-8">
            <p class="text-gray-600 mb-8">
              Apprenez tous les secrets pour devenir expert avec Claude. Du débutant au prompt engineering avancé. <strong>Accès instant</strong> au PDF complet.
            </p>

            <div class="space-y-4 mb-8">
              <div class="flex items-start gap-3">
                <span class="text-blue-500 font-bold">✓</span>
                <span class="text-sm text-gray-700">Techniques de prompt engineering avancées</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-blue-500 font-bold">✓</span>
                <span class="text-sm text-gray-700">100+ exemples concrets</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-blue-500 font-bold">✓</span>
                <span class="text-sm text-gray-700">Updates à vie incluses</span>
              </div>
            </div>

            <div class="space-y-3">
              <div class="flex justify-between items-center p-3 bg-blue-50 rounded-lg hover:bg-blue-100 transition">
                <div>
                  <p class="font-semibold text-gray-900">Starter</p>
                  <p class="text-2xl font-bold price-highlight">1€</p>
                </div>
                <a href="https://buy.stripe.com/3cI4gy9oEa6De3b3aH4wM08" target="_blank" class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition font-medium text-sm">
                  Acheter →
                </a>
              </div>

              <div class="flex justify-between items-center p-3 bg-purple-50 rounded-lg hover:bg-purple-100 transition border-2 border-purple-200">
                <div>
                  <p class="font-semibold text-gray-900">Pro <span class="text-xs font-bold text-purple-600">POPULAIRE</span></p>
                  <p class="text-2xl font-bold price-highlight">2€</p>
                </div>
                <a href="https://buy.stripe.com/fZucN4fN2diPaQZfXt4wM09" target="_blank" class="bg-purple-500 text-white px-4 py-2 rounded-lg hover:bg-purple-600 transition font-medium text-sm">
                  Acheter →
                </a>
              </div>

              <div class="flex justify-between items-center p-3 bg-pink-50 rounded-lg hover:bg-pink-100 transition">
                <div>
                  <p class="font-semibold text-gray-900">Expert</p>
                  <p class="text-2xl font-bold price-highlight">3€</p>
                </div>
                <a href="https://buy.stripe.com/28E9AS58odiPf7fdPl4wM0a" target="_blank" class="bg-pink-500 text-white px-4 py-2 rounded-lg hover:bg-pink-600 transition font-medium text-sm">
                  Acheter →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Product 2: Live Training -->
        <div class="card-shine bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="bg-gradient-to-br from-green-500 to-green-600 p-8 text-white relative">
            <div class="badge-new">EN DIRECT</div>
            <h3 class="text-2xl font-bold mb-2">Formations Live</h3>
            <p class="opacity-90 text-sm">Sessions interactives en temps réel</p>
          </div>

          <div class="p-8">
            <p class="text-gray-600 mb-8">
              Rejoignez nos sessions de formation en direct. <strong>Questions/réponses</strong>, démonstrations live, et conseils d'experts.
            </p>

            <div class="space-y-4 mb-8">
              <div class="flex items-start gap-3">
                <span class="text-green-500 font-bold">✓</span>
                <span class="text-sm text-gray-700">Interaction directe avec les experts</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 font-bold">✓</span>
                <span class="text-sm text-gray-700">Replay disponible après</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-green-500 font-bold">✓</span>
                <span class="text-sm text-gray-700">Certificat de participation</span>
              </div>
            </div>

            <div class="space-y-3">
              <div class="flex justify-between items-center p-3 bg-green-50 rounded-lg hover:bg-green-100 transition border-2 border-green-200">
                <div>
                  <p class="font-semibold text-gray-900">Standard <span class="text-xs font-bold text-green-600">BEST VALUE</span></p>
                  <p class="text-2xl font-bold price-highlight">2€</p>
                </div>
                <a href="https://buy.stripe.com/7sYfZgdEU7Yv3ox4eL4wM0b" target="_blank" class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition font-medium text-sm">
                  Rejoindre →
                </a>
              </div>

              <div class="flex justify-between items-center p-3 bg-emerald-50 rounded-lg hover:bg-emerald-100 transition">
                <div>
                  <p class="font-semibold text-gray-900">VIP <span class="text-xs font-bold text-emerald-600">PRIORITÉ</span></p>
                  <p class="text-2xl font-bold price-highlight">2.99€</p>
                  <p class="text-xs text-gray-500">+ Q&A privée 15 min</p>
                </div>
                <a href="https://buy.stripe.com/cNi14m44kemT0cl3aH4wM0c" target="_blank" class="bg-emerald-500 text-white px-4 py-2 rounded-lg hover:bg-emerald-600 transition font-medium text-sm whitespace-nowrap">
                  Réserver →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Product 3: Consultation -->
        <div class="card-shine bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
          <div class="bg-gradient-to-br from-orange-500 to-orange-600 p-8 text-white">
            <h3 class="text-2xl font-bold mb-2">Consultation 1-on-1</h3>
            <p class="opacity-90 text-sm">Audit personnalisé et stratégie sur mesure</p>
          </div>

          <div class="p-8">
            <p class="text-gray-600 mb-8">
              Consultation <strong>30 minutes</strong> avec un expert IA. Audit de vos processus et recommandations personnalisées.
            </p>

            <div class="space-y-4 mb-8">
              <div class="flex items-start gap-3">
                <span class="text-orange-500 font-bold">✓</span>
                <span class="text-sm text-gray-700">Analyse de votre situation actuelle</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-orange-500 font-bold">✓</span>
                <span class="text-sm text-gray-700">Plan d'action concret</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-orange-500 font-bold">✓</span>
                <span class="text-sm text-gray-700">Ressources et outils recommandés</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-orange-500 font-bold">✓</span>
                <span class="text-sm text-gray-700">Suivi par email pendant 1 semaine</span>
              </div>
            </div>

            <div class="flex justify-between items-center p-4 bg-orange-50 rounded-lg hover:bg-orange-100 transition border-2 border-orange-200">
              <div>
                <p class="font-semibold text-gray-900">30 minutes</p>
                <p class="text-2xl font-bold price-highlight">3€</p>
                <p class="text-xs text-gray-500">Inclus: 1 semaine de suivi</p>
              </div>
              <a href="https://buy.stripe.com/eVq5kCeIY92zgbj5iP4wM0d" target="_blank" class="bg-orange-500 text-white px-4 py-2 rounded-lg hover:bg-orange-600 transition font-medium text-sm whitespace-nowrap h-fit">
                Réserver →
              </a>
            </div>

            <p class="text-xs text-gray-500 mt-6 text-center">
              💬 Disponible par Zoom, Teams, ou téléphone
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Section -->
  <section class="py-16 px-4 bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <h3 class="text-2xl font-bold mb-8 text-gray-900">Pourquoi nous faire confiance ?</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <div class="text-4xl mb-3">🔒</div>
          <h4 class="font-bold mb-2">Paiement sécurisé</h4>
          <p class="text-gray-600 text-sm">Tous les paiements sont traités par Stripe, leader mondial de la sécurité.</p>
        </div>
        <div>
          <div class="text-4xl mb-3">⚡</div>
          <h4 class="font-bold mb-2">Accès immédiat</h4>
          <p class="text-gray-600 text-sm">Reçevez vos ressources par email dans les 2 minutes suivant le paiement.</p>
        </div>
        <div>
          <div class="text-4xl mb-3">🎯</div>
          <h4 class="font-bold mb-2">Garantie satisfaction</h4>
          <p class="text-gray-600 text-sm">Remboursement complet dans les 7 jours si vous n'êtes pas satisfait.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="py-12 px-4 bg-gradient-to-r from-purple-600 to-blue-600 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h3 class="text-3xl font-bold mb-4">Prêt à transformer votre approche de l'IA ?</h3>
      <p class="text-lg opacity-90 mb-6">Choisissez votre première offre et commencez dès aujourd'hui.</p>
      <p class="text-sm opacity-75">Tarifs avantageux de lancement. Valable cette semaine.</p>
    </div>
  </section>
</Layout>
