---
// Page autonome — pas de Layout, pas de Header/Footer.
// Les visiteurs ne voient pas le reste du site.
import '../../styles/global.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Atelier, audit, création, formation — Champforgeuil</title>
    <meta name="description" content="Après la conférence : atelier IA en confiance, audit IA, création accompagnée ou formation professionnelle. Laissez vos coordonnées." />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>

    <section class="section-hero">
      <div class="wrap" style="max-width: 36rem;">
        <p class="legende uppercase tracking-wider mb-4">Opentek — Vincent Hermitant</p>
        <h1 class="titre-page">Pour aller plus loin</h1>
        <p class="chapo mt-4">Après la conférence, quatre façons de continuer : un atelier pratique, un audit de votre activité, une création accompagnée, ou une formation professionnelle.</p>
      </div>
    </section>

    <section class="section bg-sauge-clair/50">
      <div class="wrap" style="max-width: 36rem;">

        <h2 class="titre-section mb-6">Vous êtes intéressé(e) ?</h2>
        <p class="mb-6">Laissez vos coordonnées et cochez ce qui vous concerne. Rien ne vous engage, à part le simple souhait de rester en contact — je vous recontacte avec les détails selon ce que vous aurez coché.</p>

        <form id="form" autocomplete="off" class="mesure">
          <div class="mb-5">
            <label for="prenom" class="block font-semibold mb-1">Prénom</label>
            <input type="text" id="prenom" name="prenom" required autofocus
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="Votre prénom" />
          </div>

          <div class="mb-5">
            <label for="nom" class="block font-semibold mb-1">Nom</label>
            <input type="text" id="nom" name="nom" required
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="Votre nom" />
          </div>

          <div class="mb-5">
            <label for="email" class="block font-semibold mb-1">Adresse email</label>
            <input type="email" id="email" name="email" required
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="votre@email.fr" />
          </div>

          <div class="mb-5">
            <label for="telephone" class="block font-semibold mb-1">Téléphone <span class="texte-secondaire font-normal">(facultatif)</span></label>
            <input type="tel" id="telephone" name="telephone"
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="06 ..." />
          </div>

          <div class="mb-5">
            <label for="village" class="block font-semibold mb-1">Commune</label>
            <input type="text" id="village" name="village"
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="Champforgeuil, Chalon-sur-Saône…" />
          </div>

          <div class="mb-8 pt-2">
            <p class="font-semibold mb-1">Ce qui vous intéresse</p>
            <p class="texte-secondaire mb-3">Cochez une ou plusieurs propositions :</p>

            <label class="flex items-start gap-3 cursor-pointer mb-3 pb-3 border-b border-sauge-clair">
              <input type="checkbox" id="liste" name="liste" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span><strong>Rester en contact</strong> — aucun engagement, je vous tiens simplement informé(e)</span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer mb-3">
              <input type="checkbox" id="atelier" name="atelier" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span><strong>Atelier d'initiation</strong> — « L'IA en confiance », deux demi-journées en petit groupe (3 à 6 pers.) pour découvrir l'IA, l'utiliser au quotidien et repérer les arnaques</span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer mb-3">
              <input type="checkbox" id="creation" name="creation" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span><strong>Création accompagnée</strong> — livre, site web, application...</span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer mb-3">
              <input type="checkbox" id="audit" name="audit" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span><strong>Audit IA</strong> — diagnostic personnalisé de votre activité professionnelle</span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer mb-3">
              <input type="checkbox" id="formation" name="formation" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span><strong>Formation professionnelle</strong> — formation certifiante, finançable par votre OPCO</span>
            </label>
          </div>

          <div class="mb-6">
            <label for="autre" class="block font-semibold mb-1">Autre demande <span class="texte-secondaire font-normal">(facultatif)</span></label>
            <input type="text" id="autre" name="autre"
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="Dites-moi ce dont vous avez besoin" />
          </div>

          <!-- Piège anti-bot — caché -->
          <div style="position:absolute;left:-9999px;" aria-hidden="true">
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="mb-6">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" id="consentement" name="consentement" required
                class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span class="texte-secondaire leading-snug">J'accepte d'être recontacté(e) par Vincent Hermitant au sujet de ma demande. Mes données ne seront pas transmises à des tiers.</span>
            </label>
          </div>

          <button type="submit" id="btn-submit" class="btn btn-or w-full">
            Je suis intéressé(e)
          </button>

          <p id="erreur" class="text-red-700 mt-3 hidden"></p>
        </form>

        <div id="merci" hidden class="text-center py-12">
          <p class="titre-section text-sauge-fonce mb-3">Merci !</p>
          <p class="chapo">Je vous recontacte bientôt.</p>
          <p class="texte-secondaire mt-6"><a href="/champforgeuil/" class="underline text-sauge-fonce">Retour au formulaire</a></p>
        </div>

      </div>
    </section>

    <footer class="py-6 text-center">
      <p class="legende">Vincent Hermitant — 06 46 24 61 99 — <a href="mailto:vincent@opentek.fr" class="underline text-sauge-fonce">vincent@opentek.fr</a></p>
    </footer>

    <script is:inline>
      (function () {
        var WEBHOOK = 'https://n8n.opentek.fr/webhook/atelier-ia-champforgeuil';
        var STORAGE_KEY = 'ia-confiance-champforgeuil-inscrits';
        var form = document.getElementById('form');
        var merci = document.getElementById('merci');
        var erreur = document.getElementById('erreur');
        var btn = document.getElementById('btn-submit');

        function sauvegardeLocale(data) {
          try {
            var liste = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
            liste.push(data);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(liste));
          } catch (e) {}
        }

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          erreur.classList.add('hidden');
          btn.disabled = true;
          btn.textContent = 'Envoi…';

          var prenom = document.getElementById('prenom').value.trim();
          var nom = document.getElementById('nom').value.trim();
          var email = document.getElementById('email').value.trim().toLowerCase();
          var telephone = document.getElementById('telephone').value.trim();
          var village = document.getElementById('village').value.trim();
          var liste = document.getElementById('liste').checked;
          var atelier = document.getElementById('atelier').checked;
          var audit = document.getElementById('audit').checked;
          var creation = document.getElementById('creation').checked;
          var formation = document.getElementById('formation').checked;
          var autre = document.getElementById('autre').value.trim();
          var honeypot = document.getElementById('website').value;

          var payload = {
            prenom: prenom,
            nom: nom,
            email: email,
            telephone: telephone,
            village: village,
            liste: liste,
            atelier: atelier,
            audit: audit,
            creation: creation,
            formation: formation,
            autre: autre,
            website: honeypot
          };

          sauvegardeLocale({
            prenom: prenom,
            nom: nom,
            email: email,
            telephone: telephone,
            village: village,
            liste: liste,
            atelier: atelier,
            audit: audit,
            creation: creation,
            formation: formation,
            autre: autre,
            date: new Date().toISOString()
          });

          fetch(WEBHOOK, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          })
          .then(function (r) {
            if (!r.ok) throw new Error(r.status);
            form.hidden = true;
            merci.hidden = false;
          })
          .catch(function () {
            form.hidden = true;
            merci.hidden = false;
          });
        });
      })();
    </script>

  </body>
</html>
