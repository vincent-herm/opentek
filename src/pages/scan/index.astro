---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Scanner une carte" noindex>
  <section class="section-hero">
    <div class="wrap">
      <h1 class="titre-page">Scanner une carte</h1>
      <p class="chapo mt-4">Photo + commentaire vocal — fiche créée automatiquement dans le CRM.</p>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">

      <div id="form-zone" class="mesure space-y-6">

        <!-- Photo -->
        <div>
          <label class="block titre-mini mb-1">Photo de la carte</label>
          <label id="zone-photo"
            class="flex flex-col items-center justify-center gap-3 rounded-xl border-2 border-dashed border-sauge-clair bg-white px-4 py-8 cursor-pointer hover:bg-sauge-clair/40 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-sauge" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-sauge font-medium" id="label-photo">Appuyer pour photographier</span>
            <input id="photo" type="file" accept="image/*" capture="environment" class="sr-only" />
          </label>
          <img id="preview" class="mt-3 hidden rounded-xl w-full object-contain max-h-56 border border-sauge-clair" alt="Aperçu de la carte" />
        </div>

        <!-- Commentaire -->
        <div>
          <label class="block titre-mini mb-1" for="commentaire">Commentaire</label>
          <div class="relative">
            <textarea id="commentaire" rows="4"
              placeholder="Dicte ou tape ton commentaire : contexte de la rencontre, intérêt exprimé, à relancer quand…"
              class="w-full rounded-lg border border-sauge-clair bg-white px-3 py-2 text-texte focus:border-sauge focus:outline-none resize-none"></textarea>
            <button id="btn-dicter" type="button"
              class="absolute bottom-2 right-2 btn btn-or text-sm"
              title="Dicter le commentaire">
              <svg id="icone-micro" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-7a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
              <span id="label-micro">Dicter</span>
            </button>
          </div>
          <p id="aide-micro" class="legende mt-1 hidden">Dictée non disponible sur ce navigateur — tapez directement.</p>
        </div>

        <!-- Envoi -->
        <button id="btn-envoyer" type="button" class="btn btn-or w-full justify-center py-3 text-base">
          Créer la fiche
        </button>

      </div>

      <!-- Résultat -->
      <div id="resultat" class="mesure hidden">

        <div id="spinner" class="flex flex-col items-center gap-4 py-16 text-sauge">
          <svg class="h-10 w-10 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <p class="chapo">Analyse en cours…</p>
        </div>

        <div id="succes" class="hidden rounded-2xl bg-white border border-sauge-clair p-6 space-y-4">
          <span class="block w-8 h-0.5 bg-dore mb-3"></span>
          <p class="titre-section text-sauge">Fiche créée</p>
          <dl id="recap" class="space-y-2 text-texte"></dl>
          <button id="btn-nouvelle" class="btn btn-ligne w-full justify-center mt-4">
            Scanner une autre carte
          </button>
        </div>

        <div id="erreur" class="hidden rounded-2xl bg-white border border-sauge-clair p-6">
          <p class="titre-mini text-texte" id="msg-erreur">Une erreur est survenue.</p>
          <button id="btn-retour" class="btn btn-ligne w-full justify-center mt-4">
            Retour
          </button>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
const WEBHOOK = 'https://n8n.opentek.fr/webhook/opentek-scan-carte';

const photoInput  = document.getElementById('photo') as HTMLInputElement;
const preview     = document.getElementById('preview') as HTMLImageElement;
const labelPhoto  = document.getElementById('label-photo') as HTMLElement;
const commentaire = document.getElementById('commentaire') as HTMLTextAreaElement;
const btnDicter   = document.getElementById('btn-dicter') as HTMLButtonElement;
const labelMicro  = document.getElementById('label-micro') as HTMLElement;
const aideMicro   = document.getElementById('aide-micro') as HTMLElement;
const btnEnvoyer  = document.getElementById('btn-envoyer') as HTMLButtonElement;
const formZone    = document.getElementById('form-zone') as HTMLElement;
const resultat    = document.getElementById('resultat') as HTMLElement;
const spinner     = document.getElementById('spinner') as HTMLElement;
const succes      = document.getElementById('succes') as HTMLElement;
const erreur      = document.getElementById('erreur') as HTMLElement;
const recap       = document.getElementById('recap') as HTMLElement;
const msgErreur   = document.getElementById('msg-erreur') as HTMLElement;

// Aperçu photo
photoInput.addEventListener('change', () => {
  const file = photoInput.files?.[0];
  if (!file) return;
  preview.src = URL.createObjectURL(file);
  preview.classList.remove('hidden');
  labelPhoto.textContent = 'Photo sélectionnée';
});

// Dictée (Web Speech API)
let recognition: any = null;
let dicteeActive = false;
const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;

if (!SpeechRecognition) {
  aideMicro.classList.remove('hidden');
  btnDicter.classList.add('hidden');
} else {
  recognition = new SpeechRecognition();
  recognition.lang = 'fr-FR';
  recognition.continuous = true;
  recognition.interimResults = true;

  let baseText = '';
  recognition.onstart = () => {
    dicteeActive = true;
    labelMicro.textContent = 'Arrêter';
  };
  recognition.onend = () => {
    dicteeActive = false;
    labelMicro.textContent = 'Dicter';
    baseText = commentaire.value;
  };
  recognition.onresult = (e: any) => {
    let interim = '';
    let final = baseText;
    for (let i = e.resultIndex; i < e.results.length; i++) {
      if (e.results[i].isFinal) final += e.results[i][0].transcript + ' ';
      else interim += e.results[i][0].transcript;
    }
    commentaire.value = final + interim;
    baseText = final;
  };

  btnDicter.addEventListener('click', () => {
    if (dicteeActive) recognition.stop();
    else { baseText = commentaire.value; recognition.start(); }
  });
}

// Envoi
btnEnvoyer.addEventListener('click', async () => {
  const file = photoInput.files?.[0];
  if (!file) { alert('Choisissez une photo.'); return; }

  const photoBase64: string = await new Promise((res, rej) => {
    const reader = new FileReader();
    reader.onload = () => res((reader.result as string).split(',')[1]);
    reader.onerror = rej;
    reader.readAsDataURL(file);
  });

  formZone.classList.add('hidden');
  resultat.classList.remove('hidden');
  spinner.classList.remove('hidden');
  succes.classList.add('hidden');
  erreur.classList.add('hidden');

  try {
    const resp = await fetch(WEBHOOK, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        photoBase64,
        photoType: file.type || 'image/jpeg',
        commentaire: commentaire.value.trim(),
      }),
    });

    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.error) throw new Error(data.message || `Erreur ${resp.status}`);

    spinner.classList.add('hidden');
    succes.classList.remove('hidden');

    const fiche = data.fiche || {};
    const ordre = ['Nom', 'Structure', 'Email', 'Téléphone', 'Offre', 'Guichet', 'Étape'];
    recap.innerHTML = ordre
      .filter(k => fiche[k])
      .map(k => `<div class="flex gap-2 text-sm"><dt class="font-medium w-28 shrink-0">${k}</dt><dd class="text-texte/80">${fiche[k]}</dd></div>`)
      .join('');

  } catch (e: any) {
    spinner.classList.add('hidden');
    erreur.classList.remove('hidden');
    msgErreur.textContent = e.message || 'Une erreur est survenue.';
  }
});

document.getElementById('btn-nouvelle')!.addEventListener('click', () => {
  photoInput.value = '';
  preview.classList.add('hidden');
  labelPhoto.textContent = 'Appuyer pour photographier';
  commentaire.value = '';
  formZone.classList.remove('hidden');
  resultat.classList.add('hidden');
});
document.getElementById('btn-retour')!.addEventListener('click', () => {
  formZone.classList.remove('hidden');
  resultat.classList.add('hidden');
});
</script>
