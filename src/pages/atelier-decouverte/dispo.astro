---
// Page autonome — pas de Layout, pas de Header/Footer.
import '../../styles/global.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Ateliers Découverte IA — L'IA en confiance</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>

    <section class="section-hero">
      <div class="wrap" style="max-width: 36rem;">
        <p class="legende uppercase tracking-wider mb-4">Opentek — Vincent Hermitant</p>
        <h1 class="titre-page">L'IA en confiance</h1>
        <p class="chapo mt-4">Deux ateliers pratiques de 3 heures pour découvrir l'intelligence artificielle sur votre propre ordinateur. Petit groupe, rythme humain, zéro jargon.</p>
      </div>
    </section>

    <section class="section bg-sauge-clair/50">
      <div class="wrap" style="max-width: 36rem;">

        <form id="form" autocomplete="off" class="mesure">

          <div class="mb-6 grid grid-cols-2 gap-4">
            <div>
              <label for="prenom" class="block font-semibold mb-1">Prénom</label>
              <input type="text" id="prenom" name="prenom" required autofocus
                class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
                placeholder="Votre prénom" />
            </div>
            <div>
              <label for="nom" class="block font-semibold mb-1">Nom</label>
              <input type="text" id="nom" name="nom" required
                class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
                placeholder="Votre nom" />
            </div>
          </div>

          <div class="mb-6">
            <label for="email" class="block font-semibold mb-1">Votre adresse email</label>
            <p class="texte-secondaire mb-2">Pour vous recontacter avec les détails pratiques.</p>
            <input type="email" id="email" name="email" required
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="votre@email.fr" />
          </div>

          <!-- Atelier 1 -->
          <div class="mb-8">
            <div class="mb-4">
              <span class="block w-8 h-0.5 bg-dore mb-3"></span>
              <p class="titre-carte font-serif text-anthracite">Atelier 1 — Découverte</p>
              <p class="texte-secondaire mt-1">Premiers pas avec l'IA : poser les bonnes questions, rédiger, créer une image, résumer un document — et reconnaître ce qu'il ne faut jamais lui confier.</p>
              <p class="texte-secondaire mt-1">3 heures · 30 € · Prérequis : être à l'aise avec son ordinateur (naviguer sur le web, retrouver un fichier dans un dossier)</p>
            </div>

            <p class="font-semibold mb-2">Choisissez votre créneau :</p>

            <div class="rounded-lg border-2 border-sauge-clair bg-white p-4 mb-3">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="a1_mar2_matin" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
                <div>
                  <span class="font-semibold">Mardi 2 décembre, 9h30 - 12h30</span>
                  <span class="texte-secondaire block">Accueil dès 9h15 · Mairie de Payzac</span>
                  <span id="places-a1-mar2" class="texte-secondaire block" hidden></span>
                </div>
              </label>
            </div>

            <div class="rounded-lg border-2 border-sauge-clair bg-white p-4 mb-3">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="a1_jeu3_matin" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
                <div>
                  <span class="font-semibold">Jeudi 3 décembre, 9h30 - 12h30</span>
                  <span class="texte-secondaire block">Accueil dès 9h15 · Mairie de Payzac</span>
                  <span id="places-a1-jeu3" class="texte-secondaire block" hidden></span>
                </div>
              </label>
            </div>

            <div class="rounded-lg border-2 border-sauge-clair bg-white p-4">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="a1_sam12_matin" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
                <div>
                  <span class="font-semibold">Samedi 12 décembre, 9h30 - 12h30</span>
                  <span class="texte-secondaire block">Accueil dès 9h15 · Mairie de Payzac</span>
                  <span id="places-a1-sam12" class="texte-secondaire block" hidden></span>
                </div>
              </label>
            </div>
          </div>

          <!-- Atelier 2 -->
          <div class="mb-8">
            <div class="mb-4">
              <span class="block w-8 h-0.5 bg-dore mb-3"></span>
              <p class="titre-carte font-serif text-anthracite">Atelier 2 — Approfondissement</p>
              <p class="texte-secondaire mt-1">Aller plus loin : automatiser des tâches, utiliser l'IA pour votre activité, comprendre les limites et les bons réflexes à garder.</p>
              <p class="texte-secondaire mt-1">3 heures · 30 € · Prérequis : avoir suivi l'atelier 1 (ou déjà utiliser l'IA régulièrement)</p>
            </div>

            <p class="font-semibold mb-2">Choisissez votre créneau :</p>

            <div class="rounded-lg border-2 border-sauge-clair bg-white p-4 mb-3">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="a2_jeu3_aprem" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
                <div>
                  <span class="font-semibold">Jeudi 3 décembre, 14h - 17h</span>
                  <span class="texte-secondaire block">Accueil dès 13h45 · Mairie de Payzac</span>
                  <span id="places-a2-jeu3" class="texte-secondaire block" hidden></span>
                </div>
              </label>
            </div>

            <div class="rounded-lg border-2 border-sauge-clair bg-white p-4 mb-3">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="a2_jeu4_aprem" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
                <div>
                  <span class="font-semibold">Jeudi 4 décembre, 14h - 17h</span>
                  <span class="texte-secondaire block">Accueil dès 13h45 · Mairie de Payzac</span>
                  <span id="places-a2-jeu4" class="texte-secondaire block" hidden></span>
                </div>
              </label>
            </div>

            <div class="rounded-lg border-2 border-sauge-clair bg-white p-4">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="a2_sam12_aprem" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
                <div>
                  <span class="font-semibold">Samedi 12 décembre, 14h - 17h</span>
                  <span class="texte-secondaire block">Accueil dès 13h45 · Mairie de Payzac</span>
                  <span id="places-a2-sam12" class="texte-secondaire block" hidden></span>
                </div>
              </label>
            </div>
          </div>

          <!-- Aucun créneau -->
          <div class="mb-8 pt-4 border-t border-sauge-clair">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="liste_attente" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span class="texte-secondaire">Aucun créneau ne me convient — prévenez-moi de la prochaine session.</span>
            </label>
          </div>

          <!-- Qui vous a parlé de cet atelier -->
          <div class="mb-6" id="bloc-ref">
            <label for="ref_visible" class="block font-semibold mb-1">Qui vous a parlé de cet atelier ? <span class="texte-secondaire font-normal">(facultatif)</span></label>
            <input type="text" id="ref_visible" name="ref_visible"
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="Prénom ou nom de la personne" />
          </div>
          <input type="hidden" id="ref" name="ref" />

          <!-- Remarque -->
          <div class="mb-6">
            <label for="autre" class="block font-semibold mb-1">Remarque <span class="texte-secondaire font-normal">(facultatif)</span></label>
            <input type="text" id="autre" name="autre"
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="Une question, une précision..." />
          </div>

          <!-- Piège anti-bot -->
          <div style="position:absolute;left:-9999px;" aria-hidden="true">
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="mb-6">
            <p class="texte-secondaire">Paiement sur place en espèces ou par chèque à l'ordre de <strong>POLLEN SCOP</strong>. 30 € par atelier.</p>
          </div>

          <button type="submit" id="btn-submit" class="btn btn-or w-full">
            Je m'inscris
          </button>

          <p id="erreur" class="text-red-700 mt-3 hidden"></p>
        </form>

        <div id="merci" hidden class="text-center py-12">
          <p class="titre-section text-sauge-fonce mb-3" id="merci-titre">Merci !</p>
          <p class="chapo" id="merci-texte">Votre inscription est enregistrée. Un email de confirmation vous est envoyé.</p>
          <p class="texte-secondaire mt-6"><a href="/atelier-decouverte/dispo" class="underline text-sauge-fonce">Retour au formulaire</a></p>
        </div>

      </div>
    </section>

    <footer class="py-10">
      <div class="wrap" style="max-width: 36rem;">
        <p class="legende text-center mb-6">Vincent Hermitant — 06 46 24 61 99 — <a href="mailto:vincent@opentek.fr" class="underline text-sauge-fonce">vincent@opentek.fr</a></p>

        <div class="border-t border-sauge-clair pt-6 text-center">
          <p class="legende">
            <a href="/mentions-legales/" class="underline text-sauge-fonce">Mentions légales</a>
            · <a href="/confidentialite/" class="underline text-sauge-fonce">Politique de confidentialité</a>
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var WEBHOOK = 'https://n8n.opentek.fr/webhook/atelier-decouverte-dispo';
        var PLACES  = 'https://n8n.opentek.fr/webhook/atelier-decouverte-places';
        var form = document.getElementById('form');
        var merci = document.getElementById('merci');
        var merciTitre = document.getElementById('merci-titre');
        var merciTexte = document.getElementById('merci-texte');
        var erreur = document.getElementById('erreur');
        var btn = document.getElementById('btn-submit');

        var params = new URLSearchParams(window.location.search);
        if (params.get('prenom')) document.getElementById('prenom').value = params.get('prenom');
        if (params.get('nom'))    document.getElementById('nom').value = params.get('nom');
        if (params.get('email'))  document.getElementById('email').value = params.get('email');

        var refParam = params.get('ref') || '';
        if (refParam) {
          document.getElementById('ref').value = refParam;
          document.getElementById('bloc-ref').hidden = true;
        }

        var CRENEAUX = [
          { champ: 'a1_mar2_matin',  el: 'places-a1-mar2' },
          { champ: 'a1_jeu3_matin',  el: 'places-a1-jeu3' },
          { champ: 'a1_sam12_matin', el: 'places-a1-sam12' },
          { champ: 'a2_jeu3_aprem',  el: 'places-a2-jeu3' },
          { champ: 'a2_jeu4_aprem',  el: 'places-a2-jeu4' },
          { champ: 'a2_sam12_aprem', el: 'places-a2-sam12' }
        ];

        fetch(PLACES)
          .then(function (r) { return r.json(); })
          .then(function (d) {
            CRENEAUX.forEach(function (c) {
              var info = d[c.champ];
              if (!info || !info.afficher) return;
              var el = document.getElementById(c.el);
              el.hidden = false;
              if (info.complet) {
                el.innerHTML = '<span class="font-semibold text-dore">COMPLET</span> — inscription en liste d\'attente';
              } else {
                el.innerHTML = 'Il reste <span class="font-semibold text-dore">' + info.restantes + ' place' + (info.restantes > 1 ? 's' : '') + '</span> sur ' + info.max + '.';
              }
            });
          })
          .catch(function () {});

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          erreur.classList.add('hidden');

          var choix = ['a1_mar2_matin', 'a1_jeu3_matin', 'a1_sam12_matin', 'a2_jeu3_aprem', 'a2_jeu4_aprem', 'a2_sam12_aprem', 'liste_attente'];
          var auMoinsUn = choix.some(function (n) { return form[n] && form[n].checked; });
          if (!auMoinsUn) {
            erreur.textContent = 'Cochez au moins un créneau (ou la case « aucun créneau »).';
            erreur.classList.remove('hidden');
            return;
          }

          btn.disabled = true;
          btn.textContent = 'Envoi…';

          var ref = document.getElementById('ref').value || document.getElementById('ref_visible').value.trim();

          var payload = {
            prenom:         document.getElementById('prenom').value.trim(),
            nom:            document.getElementById('nom').value.trim(),
            email:          document.getElementById('email').value.trim().toLowerCase(),
            a1_mar2_matin:  form.a1_mar2_matin.checked,
            a1_jeu3_matin:  form.a1_jeu3_matin.checked,
            a1_sam12_matin: form.a1_sam12_matin.checked,
            a2_jeu3_aprem:  form.a2_jeu3_aprem.checked,
            a2_jeu4_aprem:  form.a2_jeu4_aprem.checked,
            a2_sam12_aprem: form.a2_sam12_aprem.checked,
            liste_attente:  form.liste_attente.checked,
            ref:            ref,
            autre:          document.getElementById('autre').value.trim(),
            website:        document.getElementById('website').value
          };

          fetch(WEBHOOK, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          })
          .then(function (r) {
            if (!r.ok) throw new Error(r.status);
            return r.json().catch(function () { return null; });
          })
          .then(function (rep) {
            var complets = [];
            if (rep) {
              CRENEAUX.forEach(function (c) {
                if (payload[c.champ] && rep[c.champ] && rep[c.champ].complet) {
                  complets.push(c.champ);
                }
              });
            }

            if (complets.length > 0 && complets.length === choix.filter(function (n) { return n !== 'liste_attente' && payload[n]; }).length) {
              merciTitre.textContent = "Vous êtes en liste d'attente";
              merciTexte.textContent = "Les créneaux choisis sont complets. Si une place se libère, vous serez inscrit·e automatiquement — vous recevrez un email.";
            } else if (complets.length > 0) {
              merciTitre.textContent = 'Merci !';
              merciTexte.textContent = "Certains créneaux sont complets : vous y êtes en liste d'attente. Pour les autres, votre inscription est confirmée.";
            } else if (payload.liste_attente && !choix.some(function (n) { return n !== 'liste_attente' && payload[n]; })) {
              merciTitre.textContent = 'Merci !';
              merciTexte.textContent = 'Votre demande est enregistrée. Je vous préviendrai des prochaines dates.';
            } else {
              merciTitre.textContent = 'Merci !';
              merciTexte.textContent = 'Votre inscription est enregistrée. Un email de confirmation vous est envoyé.';
            }
            form.hidden = true;
            merci.hidden = false;
          })
          .catch(function () {
            merciTitre.textContent = 'Merci !';
            merciTexte.textContent = 'Votre inscription est enregistrée. Je vous recontacte rapidement.';
            form.hidden = true;
            merci.hidden = false;
          });
        });
      })();
    </script>

  </body>
</html>
