---
import Layout from '../../layouts/Layout.astro';
import content from '../../content/prestations.json';
---

<Layout title="Prestations — Sites web, automatisations, accompagnement">
  <section class="section-hero">
    <div class="wrap">
      <h1 class="titre-page">{content.hero.title}</h1>
      <p class="chapo mt-4">{content.hero.subtitle}</p>
      <p class="mesure mt-3 text-texte/80">{content.hero.description}</p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href="tel:+33646246199" class="btn btn-or">
          {content.hero.ctaTel}
        </a>
        <a href="mailto:vincent@opentek.fr" class="btn btn-ligne">
          {content.hero.ctaMail}
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <p class="text-xs uppercase tracking-wide text-sauge-fonce mb-2">{content.constat.etiquette}</p>
      <h2 class="titre-section mb-4">{content.constat.titre}</h2>
      <p class="text-texte/80 mesure">{content.constat.texte1}</p>
      <p class="text-texte/70 mt-3 mesure">{content.constat.texte2}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="titre-section mb-6">{content.offres.titre}</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs uppercase text-sauge-fonce border-b border-sauge-clair">
              <th class="text-left py-3 pr-4">Offre</th>
              <th class="text-right py-3 pr-4">Prix</th>
              <th class="text-right py-3">Délai</th>
            </tr>
          </thead>
          <tbody class="text-texte/80">
            {content.offres.lignes.map(l => (
              <tr class="border-b border-sauge-clair">
                <td class="py-3 pr-4"><strong>{l.nom}</strong><br><span class="legende">{l.detail}</span></td>
                <td class="text-right py-3 pr-4 whitespace-nowrap"><strong>{l.prix}</strong></td>
                <td class="text-right py-3 whitespace-nowrap">{l.delai}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="legende mt-3">{content.offres.note}</p>
      <p class="texte-secondaire mt-2">{content.offres.wordpress}</p>
    </div>
  </section>

  <section id="automatisation" class="section bg-sauge-clair/50">
    <div class="wrap">
      <p class="text-xs uppercase tracking-wide text-sauge-fonce mb-2">{content.prestations.etiquette}</p>
      <h2 class="titre-section mb-3">{content.prestations.titre}</h2>
      <p class="texte-secondaire mb-6">{content.prestations.sousTitre}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {content.prestations.cartes.map(c => (
          <div class="bg-white border border-sauge-clair rounded-xl p-5">
            <h3 class="titre-carte">{c.titre}</h3>
            <p class="texte-secondaire mt-1">{c.texte}</p>
          </div>
        ))}
      </div>
      <a href="mailto:vincent@opentek.fr" class="btn btn-or mt-6">
        {content.prestations.cta}
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="titre-section mb-6">{content.processus.titre}</h2>
      <ol class="space-y-4">
        {content.processus.etapes.map((e, i) => (
          <li class="flex gap-4">
            <span class="font-bold text-sauge-fonce text-lg">{i + 1}</span>
            <div>{e}</div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.ia.titre}</h2>
      <p class="mesure text-texte/80">{content.ia.texte}</p>
      <p class="texte-secondaire mt-2">{content.ia.note} <a href={content.ia.lienFormation} class="text-sauge-fonce underline">les formations</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.preuves.titre}</h2>
      <ul class="mesure space-y-2">
        {content.preuves.sites.map(s => (
          <li><a href={s.url} class="text-sauge-fonce underline" target="_blank" rel="noopener">{s.nom}</a> — {s.description}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.qui.titre}</h2>
      <p class="mesure text-texte/80">{content.qui.texte}</p>
      <a href="/qui-suis-je/" class="text-sm text-sauge-fonce font-medium mt-3 inline-block hover:underline">{content.qui.cta}</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="titre-section mb-6">Questions fréquentes</h2>
      <div class="border-t border-sauge-clair">
        {content.faq.map((item, i) => (
          <details class="border-b border-sauge-clair py-4" {i === 0 ? 'open' : ''}>
            <summary class="cursor-pointer list-none titre-carte flex justify-between items-center">
              {item.question}
              <span class="text-sauge text-xl">{i === 0 ? '−' : '+'}</span>
            </summary>
            <p class="texte-secondaire mt-2">{item.reponse}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section bg-anthracite text-center">
    <div class="wrap">
      <h2 class="titre-section text-white mb-4">{content.ctaFinal.titre}</h2>
      <p class="text-white/60 text-sm mb-6">{content.ctaFinal.sousTitre}</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="tel:+33646246199" class="btn btn-or">
          {content.ctaFinal.ctaTel}
        </a>
        <a href="mailto:vincent@opentek.fr" class="btn btn-ligne-sombre">
          {content.ctaFinal.ctaMail}
        </a>
      </div>
    </div>
  </section>
</Layout>