---
import Layout from '../../layouts/Layout.astro';
import content from '../../content/certification.json';
---

<Layout title="Certification IA — RS7344">
  <section class="section-hero">
    <div class="wrap">
      <span class="badge mb-6">
        {content.hero.badge}
      </span>
      <h1 class="titre-page">
        {content.hero.title}
      </h1>
      <p class="chapo mt-4">{content.hero.sousTitre}</p>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mt-6">
        <p class="text-sm font-bold text-amber-800">{content.hero.alerteTitre}</p>
        <p class="text-sm text-amber-700 mt-1">{content.hero.alerteTexte}</p>
        <a href="#liste-cpf" class="btn btn-or mt-3">
          {content.hero.alerteCta}
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.distinction.titre}</h2>
      <p class="mesure text-texte/80">{content.distinction.texte}</p>
      <p class="mesure text-texte/70 mt-3">{content.distinction.note}</p>
      <a href="/formation/" class="text-sm text-sauge-fonce font-medium mt-3 inline-block hover:underline">{content.distinction.cta}</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.projet.titre}</h2>
      <p class="mesure text-texte/80">{content.projet.texte}</p>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section mb-6">{content.formats.titre}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white border border-sauge-clair rounded-xl p-6">
          <h3 class="titre-carte">{content.formats.distance.titre}</h3>
          <p class="texte-secondaire mt-2">{content.formats.distance.texte}</p>
        </div>
        <div class="bg-white border border-sauge-clair rounded-xl p-6">
          <h3 class="titre-carte">{content.formats.presentiel.titre}</h3>
          <p class="texte-secondaire mt-2">{content.formats.presentiel.texte}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.financement.titre}</h2>
      <p class="mesure text-texte/80">{content.financement.prix}</p>
      <p class="mesure text-texte/70 mt-2">{content.financement.exoneration}</p>
      <p class="texte-secondaire mt-4">{content.financement.note}</p>
    </div>
  </section>

  <section id="contact" class="section bg-anthracite text-center">
    <div class="wrap">
      <h2 class="titre-section text-white mb-4">{content.ctaFinal.titre}</h2>
      <span id="liste-cpf" class="block h-0 scroll-mt-24"></span>
      <p class="text-white/60 text-sm mb-6">{content.ctaFinal.sousTitre}</p>
      <a href={content.ctaFinal.lien} class="btn btn-or">
        {content.ctaFinal.cta}
      </a>
    </div>
  </section>
</Layout>