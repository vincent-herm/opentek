---
import Layout from '../layouts/Layout.astro';

const products = [
  {
    name: 'Cours Claude sur l\'IA',
    subtitle: 'Initiation au prompting',
    description: 'Apprendre à utiliser efficacement les modèles IA',
    prices: [
      { name: 'Débutant', amount: '97€', link: 'https://buy.stripe.com/cNi14mbwMemTgbjh1x4wM00' },
      { name: 'Intermédiaire', amount: '147€', link: 'https://buy.stripe.com/28E4gyasIdiPgbj26D4wM01' },
      { name: 'Avancé', amount: '197€', link: 'https://buy.stripe.com/dRmaEW7gwemT6AJ3aH4wM02' }
    ]
  },
  {
    name: 'Rencontre Claude',
    subtitle: 'Autogérée Ardèche 2026',
    description: 'Une semaine pour respirer, ralentir, se relier — avec du contenu autour de Claude et l\'IA',
    prices: [
      { name: 'Tarif plein', amount: '97€', link: 'https://buy.stripe.com/28EeVcfN27YvcZ7bHd4wM03' },
      { name: 'Tarif réduit', amount: '67€', link: 'https://buy.stripe.com/14A00i9oE1A76AJbHd4wM04' }
    ]
  },
  {
    name: 'Nutrition Claude',
    subtitle: 'Meal Planning',
    description: 'Nutrition et planification repas optimisée avec Claude — Créer des plans personnalisés',
    prices: [
      { name: 'Consultation', amount: '49€', link: 'https://buy.stripe.com/fZu14mgR6emTaQZfXt4wM05' },
      { name: 'Plan personnalisé', amount: '99€', link: 'https://buy.stripe.com/4gM6oG7gw92zcZ7dPl4wM06' },
      { name: 'Suivi complet', amount: '199€', link: 'https://buy.stripe.com/8x214mcAQ4Mj1gpaD94wM07' }
    ]
  }
];
---

<Layout title="Produits Claude">
  <main class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12 px-4">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Produits Claude</h1>
        <p class="text-lg text-gray-600">Découvrez nos formations et services alimentés par Claude</p>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {products.map((product) => (
          <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <!-- Product Header -->
            <div class="bg-gradient-to-r from-blue-600 to-blue-700 p-6 text-white">
              <h2 class="text-2xl font-bold mb-1">{product.name}</h2>
              <p class="text-blue-100">{product.subtitle}</p>
            </div>

            <!-- Product Body -->
            <div class="p-6">
              <p class="text-gray-600 mb-6">{product.description}</p>

              <!-- Prices -->
              <div class="space-y-3">
                {product.prices.map((price) => (
                  <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
                    <div>
                      <p class="font-medium text-gray-900">{price.name}</p>
                      <p class="text-lg font-bold text-blue-600">{price.amount}</p>
                    </div>
                    <a
                      href={price.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition font-medium text-sm inline-block"
                    >
                      Acheter →
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Info -->
      <div class="mt-12 bg-blue-50 border border-blue-200 rounded-lg p-6 text-center max-w-2xl mx-auto">
        <p class="text-gray-700">
          Les paiements sont sécurisés et traités par <strong>Stripe</strong>.
          Tous les tarifs incluent la TVA.
        </p>
      </div>
    </div>
  </main>


  <style>
    :global(body) {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }
  </style>
</Layout>
