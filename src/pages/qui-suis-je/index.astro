---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import content from '../../content/qui-suis-je.json';
import portrait from '../../assets/qui-suis-je/portrait-vincent.jpg';
---

<Layout title="Qui suis-je — Vincent Hermitant">
  <section class="section-hero">
    <div class="wrap flex flex-col-reverse gap-8 md:flex-row md:items-center md:justify-between md:gap-12">
      <div>
        <h1 class="titre-page">{content.hero.titre}</h1>
        <p class="text-lg text-texte/70 mt-1">{content.hero.sousTitre}</p>
        <p class="mesure text-texte/80 mt-6">{content.hero.paragraphe1}</p>
        <p class="mesure text-texte/80 mt-4">{content.hero.paragraphe2}</p>
      </div>
      <Image
        src={portrait}
        alt={content.hero.photoAlt}
        width={576}
        height={576}
        loading="eager"
        class="h-40 w-40 shrink-0 rounded-full object-cover ring-4 ring-sauge-clair md:h-72 md:w-72"
      />
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.pedagogie.titre}</h2>
      <div class="text-texte/80 space-y-3">
        <p>{content.pedagogie.texte1}</p>
        <p>{content.pedagogie.texte2}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
        {content.pedagogie.cartes.map(c => (
          <div class="bg-white border border-sauge-clair rounded-xl p-4 text-center">
            <span class="block w-8 h-0.5 bg-dore mb-3 mx-auto"></span>
            <span class="titre-mini">{c.titre}</span>
            <p class="legende mt-1">{c.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="titre-section mb-6">{content.activites.titre}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {content.activites.cartes.map(c => (
          <a href={c.lien} class="bg-white border border-sauge-clair rounded-xl p-5 transition-all hover:border-sauge">
            <h3 class="titre-carte">{c.titre}</h3>
            <p class="texte-secondaire mt-1">{c.texte}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.contact.titre}</h2>
      <div class="text-texte/80 space-y-2">
        <p><a href="mailto:{content.contact.email}" class="text-sauge-fonce underline">{content.contact.email}</a></p>
        <p><a href="tel:{content.contact.tel}" class="text-sauge-fonce underline">{content.contact.tel}</a></p>
        <p>{content.contact.adresse}</p>
      </div>
      <p class="legende mt-4">{content.contact.qualifi}</p>
    </div>
  </section>
</Layout>