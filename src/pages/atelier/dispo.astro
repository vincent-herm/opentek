---
// Page autonome — pas de Layout, pas de Header/Footer.
import '../../styles/global.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Vos disponibilités — L'IA en confiance</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>

    <section class="section-hero">
      <div class="wrap" style="max-width: 36rem;">
        <p class="legende uppercase tracking-wider mb-4">Opentek — Vincent Hermitant</p>
        <h1 class="titre-page">L'IA en confiance</h1>
        <p class="chapo mt-4">Un atelier pratique de 2h30 pour découvrir les meilleures façons d'utiliser l'intelligence artificielle, sur votre propre ordinateur. Vous apprendrez à poser les bonnes questions, rédiger un courrier en quelques secondes, créer une image, résumer une vidéo d'une heure, comprendre un document complexe — et surtout à reconnaître ce qu'il ne faut jamais lui confier. Petit groupe, rythme humain, zéro jargon.</p>
        <p class="texte-secondaire mt-3">Indiquez vos disponibilités et ce qui vous intéresse.</p>
      </div>
    </section>

    <section class="section bg-sauge-clair/50">
      <div class="wrap" style="max-width: 36rem;">

        <form id="form" autocomplete="off" class="mesure">

          <div class="mb-6">
            <label for="email" class="block font-semibold mb-1">Votre adresse email</label>
            <p class="texte-secondaire mb-2">Pour vous recontacter avec les détails pratiques.</p>
            <input type="email" id="email" name="email" required autofocus
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="votre@email.fr" />
          </div>

          <div class="mb-8">
            <p class="font-semibold mb-1">Atelier collectif (2h30, 3 à 6 personnes, 30 €)</p>
            <p class="texte-secondaire mb-2">Paiement sur place en espèces ou par chèque à l'ordre de <strong>POLLEN SCOP</strong>.</p>
            <p class="texte-secondaire mb-3">Cochez les créneaux qui vous conviennent :</p>

            <label class="flex items-start gap-3 cursor-pointer mb-3">
              <input type="checkbox" name="ven6" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span>Vendredi 6 novembre, 14h30 - 17h</span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer mb-3">
              <input type="checkbox" name="sam7m" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span>Samedi 7 novembre, 10h - 12h30</span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer mb-3">
              <input type="checkbox" name="sam7a" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span>Samedi 7 novembre, 14h30 - 17h</span>
            </label>

            <p class="texte-secondaire mt-1">Aucune case cochée = aucun créneau ne convient. Je vous proposerai d'autres dates.</p>

            <label class="flex items-start gap-3 cursor-pointer mt-4 pt-4 border-t border-sauge-clair">
              <input type="checkbox" name="liste" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span class="texte-secondaire">Aucun créneau ne me convient pour l'instant — prévenez-moi de la prochaine session.</span>
            </label>
          </div>

          <div class="mb-8">
            <p class="font-semibold mb-1">Autres prestations</p>
            <p class="texte-secondaire mb-3">Vous pouvez aussi exprimer votre intérêt pour un accompagnement individuel :</p>

            <label class="flex items-start gap-3 cursor-pointer mb-3">
              <input type="checkbox" name="audit" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span><strong>Audit IA</strong> — diagnostic personnalisé de votre activité professionnelle</span>
            </label>

            <label class="flex items-start gap-3 cursor-pointer mb-3">
              <input type="checkbox" name="creation" value="1" class="mt-1 accent-sauge-fonce w-4 h-4" />
              <span><strong>Création accompagnée</strong> — livre, site web, application...</span>
            </label>
          </div>

          <div class="mb-6">
            <label for="autre" class="block font-semibold mb-1">Autre demande <span class="texte-secondaire font-normal">(facultatif)</span></label>
            <input type="text" id="autre" name="autre"
              class="w-full px-4 py-3 rounded-lg border-2 border-sauge-clair bg-white text-texte focus:border-sauge-fonce outline-none transition"
              placeholder="Dites-moi ce dont vous avez besoin" />
          </div>

          <!-- Piège anti-bot -->
          <div style="position:absolute;left:-9999px;" aria-hidden="true">
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" id="btn-submit" class="btn btn-or w-full">
            J'envoie mes choix
          </button>

          <p id="erreur" class="text-red-700 mt-3 hidden"></p>
        </form>

        <div id="merci" hidden class="text-center py-12">
          <p class="titre-section text-sauge-fonce mb-3">Merci !</p>
          <p class="chapo">Vos disponibilités sont enregistrées. Je vous recontacte rapidement.</p>
          <p class="texte-secondaire mt-6"><a href="/atelier/dispo" class="underline text-sauge-fonce">Retour au formulaire</a></p>
        </div>

      </div>
    </section>

    <footer class="py-10">
      <div class="wrap" style="max-width: 36rem;">
        <p class="legende text-center mb-6">Vincent Hermitant — 06 46 24 61 99 — <a href="mailto:vincent@opentek.fr" class="underline text-sauge-fonce">vincent@opentek.fr</a></p>

        <div class="border-t border-sauge-clair pt-6 text-center">
          <p class="legende">
            <a href="/mentions-legales/" class="underline text-sauge-fonce">Mentions légales</a>
            · <a href="/confidentialite/" class="underline text-sauge-fonce">Politique de confidentialité</a>
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var WEBHOOK = 'https://n8n.opentek.fr/webhook/atelier-dispo';
        var form = document.getElementById('form');
        var merci = document.getElementById('merci');
        var erreur = document.getElementById('erreur');
        var btn = document.getElementById('btn-submit');
        var emailInput = document.getElementById('email');

        var params = new URLSearchParams(window.location.search);
        if (params.get('email')) emailInput.value = params.get('email');

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          erreur.classList.add('hidden');
          btn.disabled = true;
          btn.textContent = 'Envoi…';

          var payload = {
            email: document.getElementById('email').value.trim().toLowerCase(),
            ven6: form.ven6.checked,
            sam7m: form.sam7m.checked,
            sam7a: form.sam7a.checked,
            liste: form.liste.checked,
            audit: form.audit.checked,
            creation: form.creation.checked,
            autre: document.getElementById('autre').value.trim(),
            website: document.getElementById('website').value
          };

          fetch(WEBHOOK, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          })
          .then(function (r) {
            if (!r.ok) throw new Error(r.status);
            form.hidden = true;
            merci.hidden = false;
          })
          .catch(function () {
            form.hidden = true;
            merci.hidden = false;
          });
        });
      })();
    </script>

  </body>
</html>
