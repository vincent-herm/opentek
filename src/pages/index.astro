---
import Layout from '../layouts/Layout.astro';
import content from '../content/index.json';
---

<Layout title="Accueil — Formation IA & Prestations numériques">
  <section class="section-hero">
    <div class="wrap text-center">
      <span class="badge mb-8">
        {content.hero.badge}
      </span>
      <h1 class="titre-page">
        {content.hero.title}<br>
        {content.hero.subtitle}
      </h1>
      <p class="chapo mt-6 mx-auto">
        {content.hero.description}
      </p>
      <div class="flex flex-wrap justify-center gap-3 mt-10">
        <a href="/formation/" class="btn btn-or">
          {content.hero.ctaFormation}
        </a>
        <a href="/prestations/" class="btn btn-ligne">
          {content.hero.ctaPrestations}
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section text-center mb-12">
        {content.aiguillage.titre}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {content.aiguillage.cartes.map(carte => (
          <a href={carte.lien} class="bg-white border border-sauge-clair rounded-xl p-6 transition-all hover:border-sauge hover:-translate-y-0.5">
            <span class="text-3xl block mb-3">{carte.icone}</span>
            <h3 class="font-bold text-anthracite">{carte.titre}</h3>
            <p class="text-sm text-texte/60 mt-1 leading-relaxed">{carte.texte}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap text-center">
      <p class="mesure mx-auto text-texte/60">{content.bio}</p>
      <a href="/qui-suis-je/" class="inline-flex items-center gap-1 text-sm text-sauge-fonce font-medium mt-4 hover:underline">
        {content.ctaBio}
      </a>
    </div>
  </section>

  <section class="section bg-anthracite text-center">
    <div class="wrap">
      <h2 class="titre-section text-white mb-4">
        {content.ctaFinal.titre}
      </h2>
      <p class="text-sm text-white/60 mb-6">
        {content.ctaFinal.sousTitre}
      </p>
      <a href="tel:+33646246199" class="btn btn-or">
        {content.ctaFinal.cta}
      </a>
    </div>
  </section>
</Layout>