---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import content from '../content/index.json';
import imageHero from '../assets/accueil/muret-ardeche.jpg';
import imageBio from '../assets/accueil/table-atelier.jpg';
---

<Layout title="Accueil — Formation IA & Prestations numériques">
  <section class="section-hero">
    <div class="wrap grid grid-cols-1 md:grid-cols-[1.4fr_1fr] gap-10 items-center">
      <div>
        <span class="badge mb-6">
          {content.hero.badge}
        </span>
        <h1 class="titre-page">
          {content.hero.title} {content.hero.subtitle}
        </h1>
        <p class="chapo mt-6">
          {content.hero.description}
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="/formation/" class="btn btn-or">
            {content.hero.ctaFormation}
          </a>
          <a href="/prestations/" class="btn btn-ligne">
            {content.hero.ctaPrestations}
          </a>
        </div>
      </div>
      <Image
        src={imageHero}
        alt={content.images.hero.alt}
        widths={[400, 600, 800]}
        sizes="(min-width: 768px) 384px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="w-full aspect-[4/3] md:aspect-[4/5] object-cover rounded-xl"
      />
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section text-center mb-12">
        {content.aiguillage.titre}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {content.aiguillage.cartes.map(carte => (
          <a href={carte.lien} class="bg-white border border-sauge-clair rounded-xl p-6 transition-all hover:border-sauge hover:-translate-y-0.5">
            <span class="block w-8 h-0.5 bg-dore mb-4"></span>
            <h3 class="titre-carte">{carte.titre}</h3>
            <p class="texte-secondaire mt-1 leading-relaxed">{carte.texte}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-cols-1 md:grid-cols-[1fr_1.4fr] gap-10 items-center">
      <Image
        src={imageBio}
        alt={content.images.bio.alt}
        widths={[400, 600, 800]}
        sizes="(min-width: 768px) 384px, 100vw"
        class="w-full aspect-[4/3] object-cover rounded-xl"
      />
      <div>
        <p class="mesure text-texte/80">{content.bio}</p>
        <a href="/qui-suis-je/" class="inline-flex items-center gap-1 text-sm text-sauge-fonce font-medium mt-4 hover:underline">
          {content.ctaBio}
        </a>
      </div>
    </div>
  </section>

  <section id="contact" class="section bg-anthracite text-center">
    <div class="wrap">
      <h2 class="titre-section text-white mb-4">
        {content.ctaFinal.titre}
      </h2>
      <p class="text-sm text-white/60 mb-6">
        {content.ctaFinal.sousTitre}
      </p>
      <a href="tel:+33646246199" class="btn btn-or">
        {content.ctaFinal.cta}
      </a>
    </div>
  </section>
</Layout>
