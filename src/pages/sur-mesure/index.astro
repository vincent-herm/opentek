---
import Layout from '../../layouts/Layout.astro';
import content from '../../content/sur-mesure.json';
---

<Layout title="Sur mesure — automatisation, application, données, second cerveau" description="Automatiser ce qui se refait à la main, construire l'outil qui manque, remettre vos informations au même endroit. Pour les TPE, PME et associations. Sur devis.">
  <section class="section-hero">
    <div class="wrap">
      <span class="badge mb-6">{content.hero.badge}</span>
      <h1 class="titre-page">{content.hero.title}</h1>
      <p class="chapo mt-4">{content.hero.sousTitre}</p>
      <a href="/contact/?offre=Diagnostic%20IA&page=/sur-mesure/" class="btn btn-or mt-8">
        {content.hero.cta}
      </a>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.constat.titre}</h2>
      <p class="mesure text-texte/80">{content.constat.texte}</p>
      <p class="texte-secondaire mt-3">
        {content.constat.note} <a href="/formation/" class="text-sauge-fonce underline">Voir les formations</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="titre-section mb-2">{content.depart.titre}</h2>
      <p class="mesure text-texte/80 mb-6">{content.depart.intro}</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {content.depart.etapes.map(e => (
          <div class="bg-anthracite rounded-xl p-6 border-t-4 border-dore">
            <p class="text-xs uppercase tracking-wide text-dore mb-1">{e.etiquette}</p>
            <h3 class="titre-carte text-white">{e.titre}</h3>
            <p class="titre-carte text-dore mt-1">{e.prix}</p>
            <p class="text-white/80 mt-3">{e.texte}</p>
            {e.note && <p class="text-white/70 text-sm mt-3">{e.note}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section mb-6">{content.offres.titre}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {content.offres.cartes.map(c => (
          <div class="bg-white border border-sauge-clair rounded-xl p-5">
            <span class="block w-8 h-0.5 bg-dore mb-3"></span>
            <p class="text-xs uppercase tracking-wide text-sauge-fonce mb-1">{c.etiquette}</p>
            <h3 class="titre-carte">{c.titre}</h3>
            <p class="texte-secondaire mt-2">{c.texte}</p>
          </div>
        ))}
      </div>
      <p class="texte-secondaire mt-5 mesure">{content.offres.note}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="titre-section mb-6">{content.methode.titre}</h2>
      <ol class="space-y-4">
        {content.methode.etapes.map((e, i) => (
          <li class="flex gap-4">
            <span class="font-bold text-sauge-fonce text-lg">{i + 1}</span>
            <div class="mesure text-texte/80">{e}</div>
          </li>
        ))}
      </ol>
      <p class="texte-secondaire mt-6 mesure">{content.methode.note}</p>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.preuve.titre}</h2>
      <ul class="mesure space-y-3">
        {content.preuve.items.map(item => (
          <li class="flex gap-3 text-texte/80"><span class="text-sauge mt-1">●</span> {item}</li>
        ))}
      </ul>
      <p class="texte-secondaire mt-5 mesure">{content.preuve.note}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="titre-section mb-4">{content.site.titre}</h2>
      <p class="mesure text-texte/80">{content.site.texte}</p>
      <a href="/site-internet/" class="btn btn-ligne mt-4">
        {content.site.cta}
      </a>
    </div>
  </section>

  <section class="section bg-sauge-clair/50">
    <div class="wrap">
      <h2 class="titre-section mb-6">Questions fréquentes</h2>
      <div class="border-t border-sauge-clair">
        {content.faq.map((item, i) => (
          <details class="border-b border-sauge-clair py-4" {i === 0 ? 'open' : ''}>
            <summary class="cursor-pointer list-none titre-carte flex justify-between items-center">
              {item.question}
              <span class="text-sauge text-xl">{i === 0 ? '−' : '+'}</span>
            </summary>
            <p class="texte-secondaire mt-2">{item.reponse}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section bg-anthracite text-center scroll-mt-24">
    <div class="wrap">
      <h2 class="titre-section text-white mb-4">{content.ctaFinal.titre}</h2>
      <p class="mesure mx-auto text-white/70 text-sm mb-6">{content.ctaFinal.sousTitre}</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/contact/?offre=Accompagnement%20IA&page=/sur-mesure/" class="btn btn-or">
          {content.ctaFinal.ctaMail}
        </a>
        <a href="tel:+33646246199" class="btn btn-ligne-sombre">
          {content.ctaFinal.ctaTel}
        </a>
      </div>
    </div>
  </section>
</Layout>
