---
// Page autonome — pas de Layout, pas de Header/Footer.
import '../styles/global.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Mon espace apporteur — Opentek</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>

    <section class="section-hero">
      <div class="wrap" style="max-width: 36rem;">
        <p class="legende uppercase tracking-wider mb-4">Opentek — Vincent Hermitant</p>
        <h1 class="titre-page">Mon espace apporteur</h1>
      </div>
    </section>

    <!-- État : chargement -->
    <section class="section bg-sauge-clair/50" id="chargement">
      <div class="wrap" style="max-width: 36rem;">
        <p class="texte-secondaire text-center py-12">Chargement…</p>
      </div>
    </section>

    <!-- État : lien invalide -->
    <section class="section bg-sauge-clair/50" id="invalide" hidden>
      <div class="wrap" style="max-width: 36rem;">
        <div class="rounded-lg border-2 border-sauge-clair bg-white p-6 sm:p-8 text-center">
          <p class="titre-section text-anthracite mb-3">Lien non reconnu</p>
          <p class="texte-secondaire">Ce lien n'est pas valide ou a expiré. Contactez Vincent pour obtenir votre lien personnel.</p>
          <p class="texte-secondaire mt-4">06 46 24 61 99 · <a href="mailto:vincent@opentek.fr" class="underline text-sauge-fonce">vincent@opentek.fr</a></p>
        </div>
      </div>
    </section>

    <!-- État : dashboard -->
    <section class="section bg-sauge-clair/50" id="dashboard" hidden>
      <div class="wrap" style="max-width: 40rem;">

        <p class="chapo mb-8">Bonjour <span id="prenom" class="font-semibold"></span></p>

        <!-- Compteurs -->
        <div class="grid gap-4 sm:grid-cols-2 mb-8">
          <div class="rounded-lg border-2 border-sauge-clair bg-white p-5 text-center">
            <p class="legende uppercase tracking-wider mb-1">Personnes amenées</p>
            <p class="titre-page text-dore" id="nb-amenes">—</p>
          </div>
          <div class="rounded-lg border-2 border-sauge-clair bg-white p-5 text-center">
            <p class="legende uppercase tracking-wider mb-1" id="solde-label">Solde</p>
            <p class="titre-page text-dore" id="solde">—</p>
          </div>
        </div>

        <!-- Lien de parrainage -->
        <div class="rounded-lg border-2 border-sauge-clair bg-white p-5 mb-8">
          <p class="font-semibold mb-2">Votre lien de parrainage</p>
          <p class="texte-secondaire mb-3">Partagez ce lien — chaque personne qui s'inscrit via ce lien vous est attribuée automatiquement.</p>
          <div class="flex flex-col sm:flex-row gap-2">
            <input type="text" id="lien-parrainage" readonly
              class="w-full min-w-0 px-4 py-3 rounded-lg border-2 border-sauge-clair bg-creme text-texte text-sm" />
            <button type="button" id="btn-copier" class="btn btn-or whitespace-nowrap shrink-0">Copier</button>
          </div>
          <p id="copie-ok" class="texte-secondaire mt-2" hidden>Lien copié !</p>
        </div>

        <!-- Détail des personnes amenées -->
        <div id="bloc-liste" hidden>
          <p class="font-semibold mb-3">Détail</p>
          <div class="rounded-lg border-2 border-sauge-clair bg-white overflow-hidden">
            <table class="w-full">
              <thead>
                <tr class="border-b border-sauge-clair">
                  <th class="text-left p-3 legende uppercase tracking-wider">Prénom</th>
                  <th class="text-left p-3 legende uppercase tracking-wider">Date</th>
                  <th class="text-right p-3 legende uppercase tracking-wider">Statut</th>
                </tr>
              </thead>
              <tbody id="liste-amenes"></tbody>
            </table>
          </div>
        </div>

        <!-- Rappel des règles -->
        <div class="mt-8 pt-6 border-t border-sauge-clair">
          <p class="texte-secondaire">30 € par personne amenée (une seule fois par personne, quel que soit le nombre d'ateliers), validée après sa venue à l'atelier. La commission est versée en cash si vous avez une micro-entreprise, en crédit sur mes services sinon.</p>
        </div>

      </div>
    </section>

    <footer class="py-10">
      <div class="wrap" style="max-width: 36rem;">
        <p class="legende text-center mb-6">Vincent Hermitant — 06 46 24 61 99 — <a href="mailto:vincent@opentek.fr" class="underline text-sauge-fonce">vincent@opentek.fr</a></p>

        <div class="border-t border-sauge-clair pt-6 text-center">
          <p class="legende">
            <a href="/mentions-legales/" class="underline text-sauge-fonce">Mentions légales</a>
            · <a href="/confidentialite/" class="underline text-sauge-fonce">Politique de confidentialité</a>
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var WEBHOOK = 'https://n8n.opentek.fr/webhook/apporteur-dashboard';
        var BASE_URL = 'https://opentek.fr/atelier-decouverte/?ref=';

        var params = new URLSearchParams(window.location.search);
        var token = params.get('t') || '';

        var chargement = document.getElementById('chargement');
        var invalide = document.getElementById('invalide');
        var dashboard = document.getElementById('dashboard');

        if (!token) {
          chargement.hidden = true;
          invalide.hidden = false;
          return;
        }

        fetch(WEBHOOK, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ t: token })
        })
        .then(function (r) {
          if (!r.ok) throw new Error(r.status);
          return r.json();
        })
        .then(function (d) {
          if (!d || !d.ok) {
            chargement.hidden = true;
            invalide.hidden = false;
            return;
          }

          document.getElementById('prenom').textContent = d.prenom || 'apporteur';
          document.getElementById('nb-amenes').textContent = d.nb_amenes || '0';

          if (d.micro) {
            document.getElementById('solde-label').textContent = 'Solde cash';
            document.getElementById('solde').textContent = (d.solde_cash || 0) + ' €';
          } else {
            document.getElementById('solde-label').textContent = 'Crédits';
            document.getElementById('solde').textContent = (d.solde_credits || 0) + ' €';
          }

          document.getElementById('lien-parrainage').value = BASE_URL + d.code_parrain;

          if (d.amenes && d.amenes.length > 0) {
            var tbody = document.getElementById('liste-amenes');
            d.amenes.forEach(function (a) {
              var tr = document.createElement('tr');
              tr.className = 'border-b border-sauge-clair last:border-0';
              var commLabel = a.statut_commission === 'validée' ? '30 €'
                : a.statut_commission === 'à valider' ? 'à valider'
                : 'en attente';
              var commClass = a.statut_commission === 'validée' ? 'font-semibold text-dore'
                : 'texte-secondaire';
              tr.innerHTML =
                '<td class="p-3">' + (a.prenom || '—') + '</td>' +
                '<td class="p-3 texte-secondaire">' + (a.date || '—') + '</td>' +
                '<td class="p-3 text-right ' + commClass + '">' + commLabel + '</td>';
              tbody.appendChild(tr);
            });
            document.getElementById('bloc-liste').hidden = false;
          }

          chargement.hidden = true;
          dashboard.hidden = false;
        })
        .catch(function () {
          chargement.hidden = true;
          invalide.hidden = false;
        });

        document.getElementById('btn-copier').addEventListener('click', function () {
          var input = document.getElementById('lien-parrainage');
          if (navigator.clipboard) {
            navigator.clipboard.writeText(input.value);
          } else {
            input.select();
            document.execCommand('copy');
          }
          document.getElementById('copie-ok').hidden = false;
          setTimeout(function () { document.getElementById('copie-ok').hidden = true; }, 2000);
        });
      })();
    </script>

  </body>
</html>
